# Database Configuration
MONGODB_URI=mongodb://localhost:27017/interviewprep

# JWT Authentication
JWT_SECRET=dev-secret-key

# Server Port
PORT=4000

# Google Gemini AI API Key
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Resend Email Delivery Configuration ──────────────────────────────────────
# Add your Resend API Key:
RESEND_API_KEY=re_123456789_abcdefgh

# Sender email address:
# If you are using Resend free tier without a custom verified domain, use:
EMAIL_FROM="InterPrep AI <onboarding@resend.dev>"
# If you have verified your own custom domain on Resend (e.g. yourdomain.com), use:
# EMAIL_FROM="InterPrep AI <no-reply@yourdomain.com>"
